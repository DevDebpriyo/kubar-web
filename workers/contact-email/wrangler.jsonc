{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kubar-contact-email-consumer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "queues": {
    "consumers": [
      {
        "queue": "kubar-contact-email",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "kubar-contact-email-dlq"
      }
    ]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "allowed_sender_addresses": ["website@mail.kubar.tech"],
      "allowed_destination_addresses": ["outreach@kubar.tech"]
    }
  ]
}
